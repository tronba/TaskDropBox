#!/usr/bin/env bash
set -Eeuo pipefail

[[ $EUID -eq 0 ]] || { echo "Run with sudo." >&2; exit 1; }
[[ -r /etc/taskdropbox/taskdropbox.env ]] || { echo "TaskDropBox configuration is missing." >&2; exit 1; }

set -a
# shellcheck disable=SC1091
source /etc/taskdropbox/taskdropbox.env
set +a
export HOME=/var/lib/taskdropbox

exec runuser -u taskdropbox --preserve-environment -- \
  /opt/taskdropbox/venv/bin/python /opt/taskdropbox/manage.py "$@"
